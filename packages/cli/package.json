{
  "name": "chiltepin",
  "version": "0.47.8",
  "description": "Documentation-as-code CLI: write Markdown with typed YAML blocks for API docs, architecture & system design (C4, ERDs, sequence diagrams), frontend & design systems, ADRs and decision records, planning, and slide presentations. Validate like code with `chiltepin check`, export to HTML, slides, or PDF. AI-native — one-command agent skill (npx skills add jdiejim/chiltepin -y) and a visual Studio.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/bin.js",
  "bin": {
    "chiltepin": "./dist/bin.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/sync-skill.mjs && node scripts/sync-readme.mjs && tsup && chmod +x dist/bin.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chiltepin-core": "workspace:*",
    "chiltepin-render": "workspace:*",
    "chiltepin-studio": "workspace:*",
    "cfonts": "^3.3.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "ink": "^5.1.0",
    "ink-select-input": "^6.0.0",
    "jiti": "^2.4.2",
    "open": "^10.1.0",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "yaml": "^2.6.1"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdiejim/chiltepin.git",
    "directory": "packages/cli"
  },
  "homepage": "https://chiltepin.dev",
  "bugs": "https://github.com/jdiejim/chiltepin/issues",
  "keywords": [
    "chiltepin",
    "documentation",
    "docs-as-code",
    "documentation-as-code",
    "markdown",
    "yaml",
    "typed-blocks",
    "diagrams",
    "diagrams-as-code",
    "mermaid-alternative",
    "sequence-diagram",
    "erd",
    "c4-model",
    "api-docs",
    "api-documentation",
    "system-design",
    "architecture",
    "architecture-diagrams",
    "adr",
    "design-system",
    "presentations",
    "technical-writing",
    "developer-docs",
    "ai-documentation",
    "claude",
    "cursor",
    "copilot",
    "studio",
    "visual-editor",
    "html",
    "slides",
    "pdf",
    "static-site-generator",
    "cli",
    "developer-tools",
    "skills",
    "documentation-generator",
    "ai-documentation-generator",
    "ai-docs",
    "docs-generator",
    "ai-doc-generator"
  ],
  "engines": {
    "node": ">=20"
  }
}
